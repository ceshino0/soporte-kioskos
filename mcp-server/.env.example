# Ejemplo de configuración de kioskos-mcp. No contiene secretos: el servidor no los necesita.
# Estas variables se pueden fijar en el bloque "env" de .mcp.json o en el entorno del sistema.
KIOSKOS_DATA_DIR=~/.kioskos-mcp
# Dominios del personal interno (además de los contactos registrados de cada cliente)
KIOSKOS_INTERNAL_DOMAINS=empresa.example
KIOSKOS_READ_ONLY=false
KIOSKOS_ACTOR=claude-code
KIOSKOS_TZ=Europe/Madrid
